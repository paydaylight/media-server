TZ=Asia/Almaty
USER_NAME=localusername
GID=1000
UID=1000

# Container config/state on the server
APPDATA_LOCATION=/srv/appdata

# =============== IMMICH ==============
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=passowrd
IMMICH_UPLOAD_LOCATION=/path/to/upload/location
IMMICH_DB_DATA_LOCATION=/path/to/pgdata
IMMICH_VERSION=v3
# =============== IMMICH ==============

# ============== JELLYFIN =============
JELLYFIN_MEDIA_LOCATION=/path/to/media
# GID of the 'render' group on the server: getent group render
RENDER_GID=105
# ============== JELLYFIN =============

# =============== SAMBA ===============
SAMBA_SHARE_PATH=/share/path
SAMBA_STORAGE_PATH=/path/to/storage
SAMBA_NAME=media
SAMBA_USER=samba
SAMBA_PASS=secret
# =============== SAMBA ===============

# ============== PIHOLE ===============
PIHOLE_PASSWORD='correct horse battery staple'
# ============== PIHOLE ===============
