TZ=Asia/Almaty
USER_NAME=localusername
GID=1000
UID=1000

# Container config/state on the server
APPDATA_LOCATION=/srv/appdata
MEDIA_LOCATION=/path/to/media
STORAGE_LOCATION=/path/to/storage

# =============== CADDY ===============
# Server's LAN address and local domain (used by Pi-hole DNS + Caddy)
SERVER_IP=192.168.0.x
LAN_DOMAIN=lan
# =============== CADDY ===============

# =============== IMMICH ==============
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=passowrd
IMMICH_UPLOAD_LOCATION=/path/to/upload/location
IMMICH_DB_DATA_LOCATION=/path/to/pgdata
IMMICH_VERSION=v3
# =============== IMMICH ==============

# ============== JELLYFIN =============
JELLYFIN_MEDIA_LOCATION=/path/to/media
# GID of the 'render' group on the server: getent group render
RENDER_GID=105
# ============== JELLYFIN =============

# =============== SAMBA ===============
SAMBA_MEDIA_PATH=/media/path
SAMBA_STORAGE_PATH=/storage/path
SAMBA_MEDIA_NAME=media
SAMBA_STORAGE_NAME=storage
# Networks allowed to connect: LAN + Tailscale
SAMBA_HOSTS_ALLOW="192.168.0.0/24 100.64.0.0/10"
SAMBA_USER=samba
SAMBA_PASS=secret
# =============== SAMBA ===============

# ============== PIHOLE ===============
PIHOLE_PASSWORD='correct horse battery staple'
# ============== PIHOLE ===============

# ============= MONITORING ==============
SCRUTINY_DISK_1=/dev/sdx
SCRUTINY_DISK_2=/dev/sdx
SCRUTINY_DISK_3=/dev/sdx
SCRUTINY_DISK_4=/dev/sdx
SCRUTINY_DISK_5=/dev/sdx

BESZEL_TOKEN=
BESZEL_KEY=
# ============= MONITORING ==============

# ============== DASHBOARD ==============
# Name of the Docker host shown on Homepage tiles (container status/CPU/RAM)
HOMEPAGE_DOCKER_SERVER=
HOMEPAGE_KUMA_SLUG=
HOMEPAGE_BESZEL_USER=
HOMEPAGE_BESZEL_PASS=
HOMEPAGE_JELLYFIN_KEY=
HOMEPAGE_IMMICH_KEY=
HOMEPAGE_SEERR_KEY=
HOMEPAGE_RADARR_KEY=
HOMEPAGE_SONARR_KEY=
HOMEPAGE_PROWLARR_KEY=
HOMEPAGE_QBIT_USER=
HOMEPAGE_QBIT_PASS=
HOMEPAGE_PIHOLE_KEY=
# ============== DASHBOARD ==============
